@model GenteFit.Datos.Cliente
@{
    ViewData["Title"] = "Detalle del cliente";
}
<h1>Detalle del cliente</h1>
@if (TempData["Mensaje"] != null) { <div class="alert alert-success">@TempData["Mensaje"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<dl class="row">
    <dt class="col-sm-3">Nombre</dt><dd class="col-sm-9">@Model.Nombre @Model.Apellidos</dd>
    <dt class="col-sm-3">DNI</dt><dd class="col-sm-9">@Model.Dni</dd>
    <dt class="col-sm-3">Correo</dt><dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">Teléfono</dt><dd class="col-sm-9">@(Model.Telefono ?? "—")</dd>
    <dt class="col-sm-3">Nacimiento</dt><dd class="col-sm-9">@(Model.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "—")</dd>
    <dt class="col-sm-3">Fecha de alta</dt><dd class="col-sm-9">@Model.FechaAlta.ToString("dd/MM/yyyy")</dd>
    <dt class="col-sm-3">Estado</dt><dd class="col-sm-9">@(Model.Activo ? "Activo" : "Dado de baja")</dd>
    @if (Model.FechaBaja.HasValue)
    {
        <dt class="col-sm-3">Fecha de baja</dt><dd class="col-sm-9">@Model.FechaBaja.Value.ToString("dd/MM/yyyy HH:mm")</dd>
    }
</dl>

<a asp-action="Index" class="btn btn-secondary">Volver</a>
@if (Model.Activo)
{
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Editar</a>
    <form asp-action="DarDeBaja" method="post" class="mt-4 border rounded p-3">
        <input type="hidden" name="id" value="@Model.Id" />
        <h5>Dar de baja al cliente</h5>
        <p class="text-muted">La baja es lógica: el registro se conserva en el sistema.</p>
        <div class="form-check mb-3">
            <input type="checkbox" class="form-check-input" id="cancelarReservas" name="cancelarReservas" value="true" />
            <label class="form-check-label" for="cancelarReservas">Cancelar también sus reservas activas y en lista de espera</label>
        </div>
        <button type="submit" class="btn btn-danger" onclick="return confirm('¿Confirmas la baja de este cliente?')">Dar de baja</button>
    </form>
}
