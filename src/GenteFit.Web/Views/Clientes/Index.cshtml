@model IEnumerable<GenteFit.Datos.Cliente>
@{
    ViewData["Title"] = "Clientes";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Clientes</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo cliente</a>
</div>

@if (TempData["Mensaje"] != null) { <div class="alert alert-success">@TempData["Mensaje"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<form method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <input name="texto" value="@ViewBag.Texto" class="form-control" placeholder="Buscar por nombre, apellidos, DNI o correo" />
    </div>
    <div class="col-md-3">
        <select name="soloActivos" class="form-select">
            <option value="true" selected="@((bool)ViewBag.SoloActivos)">Solo activos</option>
            <option value="false" selected="@(!(bool)ViewBag.SoloActivos)">Todos los clientes</option>
        </select>
    </div>
    <div class="col-md-3">
        <button class="btn btn-outline-primary" type="submit">Buscar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

<div class="table-responsive">
<table class="table table-striped table-hover align-middle">
    <thead>
        <tr><th>Cliente</th><th>DNI</th><th>Correo</th><th>Teléfono</th><th>Estado</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var cliente in Model)
    {
        <tr>
            <td>@cliente.Nombre @cliente.Apellidos</td>
            <td>@cliente.Dni</td>
            <td>@cliente.Email</td>
            <td>@(cliente.Telefono ?? "—")</td>
            <td>
                @if (cliente.Activo) { <span class="badge bg-success">Activo</span> }
                else { <span class="badge bg-secondary">Baja</span> }
            </td>
            <td class="text-end">
                <a asp-action="Details" asp-route-id="@cliente.Id" class="btn btn-sm btn-outline-primary">Ver</a>
                @if (cliente.Activo)
                {
                    <a asp-action="Edit" asp-route-id="@cliente.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
@if (!Model.Any()) { <p class="text-muted">No se han encontrado clientes.</p> }
