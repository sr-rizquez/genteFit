@model IEnumerable<GenteFit.Datos.Sala>

@{
    ViewData["Title"] = "Salas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Salas</h1>
    <a asp-action="Crear" class="btn btn-primary">Nueva sala</a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Aforo</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var sala in Model)
        {
            <tr>
                <td>@sala.Nombre</td>
                <td>@sala.Aforo personas</td>
                <td>
                    <a asp-action="Editar" asp-route-id="@sala.Id"
                       class="btn btn-sm btn-outline-primary">Editar</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
