@model IEnumerable<GenteFit.Datos.Monitor>

@{
    ViewData["Title"] = "Monitores";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Monitores</h1>
    <a asp-action="Crear" class="btn btn-primary">Nuevo monitor</a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Apellidos</th>
                <th>Email</th>
                <th>Actividades</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var monitor in Model)
        {
            <tr>
                <td>@monitor.Nombre</td>
                <td>@monitor.Apellidos</td>
                <td>@monitor.Email</td>
                <td>@string.Join(", ", monitor.Actividades.Select(a => a.Nombre))</td>
                <td>
                    @if (monitor.Activo)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactivo</span>
                    }
                </td>
                <td class="text-nowrap">
                    <a asp-action="Editar" asp-route-id="@monitor.Id"
                       class="btn btn-sm btn-outline-primary">Editar</a>
                    @if (monitor.Activo)
                    {
                        <form asp-action="DarDeBaja" asp-route-id="@monitor.Id"
                              method="post" class="d-inline"
                              onsubmit="return confirm('¿Dar de baja este monitor?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                Dar de baja
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
