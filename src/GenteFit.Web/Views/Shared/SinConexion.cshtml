@{
    ViewData["Title"] = "Base de datos no disponible";
    var reintentar = ViewData["Reintentar"] as string ?? "/";
}
<section class="gf-aviso" role="alert" aria-labelledby="titulo-aviso">
    <div class="gf-aviso__icono" aria-hidden="true">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <ellipse cx="12" cy="5" rx="8" ry="3" />
            <path d="M4 5v6c0 1.66 3.58 3 8 3s8-1.34 8-3V5" />
            <path d="M4 11v6c0 1.66 3.58 3 8 3" />
            <line x1="17" y1="15" x2="22" y2="20" />
            <line x1="22" y1="15" x2="17" y2="20" />
        </svg>
    </div>
    <h1 id="titulo-aviso" class="gf-aviso__titulo">No podemos conectar con la base de datos</h1>
    <p class="gf-aviso__texto">
        Ahora mismo no se pueden consultar ni guardar datos. Tus reservas y datos no se han perdido:
        en cuanto vuelva la conexión podrás seguir donde lo dejaste.
    </p>
    <div class="gf-aviso__acciones">
        <a class="btn btn-primary" href="@reintentar">Reintentar</a>
        <a class="btn btn-outline-secondary" href="/">Ir al inicio</a>
    </div>
    <p class="gf-aviso__ayuda">
        Si el problema continúa, avisa a recepción o al administrador del centro.
        Código del error: <strong>BD-01</strong>.
    </p>
</section>
