<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GenteFit</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GenteFit.Web.styles.css" asp-append-version="true" />
</head>
<body>
<header>
<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm mb-3">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">GenteFit</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal" aria-controls="menuPrincipal" aria-expanded="false" aria-label="Abrir menú">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="menuPrincipal">
            <ul class="navbar-nav me-auto">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole("CLIENTE"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Reservas" asp-action="Index">Mis reservas</a></li>
                    }
                    @if (User.IsInRole("ADMINISTRADOR") || User.IsInRole("RECEPCIONISTA"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Clientes" asp-action="Index">Clientes</a></li>
                    }
                    @if (User.IsInRole("ADMINISTRADOR") || User.IsInRole("ENCARGADO"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Actividades" asp-action="Index">Actividades</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Monitores" asp-action="Index">Monitores</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Salas" asp-action="Index">Salas</a></li>
                    }
                    @if (User.IsInRole("ADMINISTRADOR") || User.IsInRole("RECEPCIONISTA") || User.IsInRole("ENCARGADO"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Sesiones" asp-action="Index">Sesiones</a></li>
                    }
                    @if (User.IsInRole("ADMINISTRADOR"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Usuarios" asp-action="Index">Usuarios</a></li>
                    }
                }
            </ul>
            <ul class="navbar-nav">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item"><span class="nav-link">@User.Identity.Name</span></li>
                    <li class="nav-item">
                        <form asp-controller="Cuenta" asp-action="Logout" method="post">
                            <button type="submit" class="btn btn-outline-secondary btn-sm mt-1">Cerrar sesión</button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Cuenta" asp-action="Login">Iniciar sesión</a></li>
                }
            </ul>
        </div>
    </div>
</nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>
<footer class="border-top footer text-muted mt-4">
    <div class="container py-3">&copy; 2026 - GenteFit</div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
