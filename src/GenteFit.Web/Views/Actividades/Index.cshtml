@model IEnumerable<GenteFit.Datos.Actividad>

@{
    ViewData["Title"] = "Actividades";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Actividades</h1>
    <a asp-action="Crear" class="btn btn-primary">Nueva actividad</a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Tipo</th>
                <th>Intensidad</th>
                <th>Duración</th>
                <th>Monitores</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var actividad in Model)
        {
            <tr>
                <td>@actividad.Nombre</td>
                <td>@actividad.Tipo</td>
                <td>@actividad.Intensidad</td>
                <td>@actividad.DuracionMinutos min</td>
                <td>@string.Join(", ", actividad.Monitores.Select(m => m.Nombre + " " + m.Apellidos))</td>
                <td>
                    @if (actividad.Activa)
                    {
                        <span class="badge bg-success">Activa</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactiva</span>
                    }
                </td>
                <td class="text-nowrap">
                    <a asp-action="Editar" asp-route-id="@actividad.Id"
                       class="btn btn-sm btn-outline-primary">Editar</a>
                    <form asp-action="Eliminar" asp-route-id="@actividad.Id"
                          method="post" class="d-inline"
                          onsubmit="return confirm('¿Eliminar o desactivar esta actividad?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            Dar de baja
                        </button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
