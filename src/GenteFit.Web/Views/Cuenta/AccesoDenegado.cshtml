@{
    ViewData["Title"] = "Acceso denegado";
}
<section class="gf-aviso gf-aviso--peligro" role="alert" aria-labelledby="titulo-aviso">
    <div class="gf-aviso__icono" aria-hidden="true">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="11" width="16" height="10" rx="2" />
            <path d="M8 11V7a4 4 0 0 1 8 0v4" />
        </svg>
    </div>
    <h1 id="titulo-aviso" class="gf-aviso__titulo">No tienes acceso a esta sección</h1>
    <p class="gf-aviso__texto">Esta opción no está disponible para tu rol. Si crees que deberías poder entrar, habla con el administrador del centro.</p>
    <div class="gf-aviso__acciones">
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Volver al inicio</a>
    </div>
</section>
