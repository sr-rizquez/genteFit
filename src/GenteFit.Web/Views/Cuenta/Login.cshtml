@model GenteFit.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_LayoutAcceso";
}

<div class="gf-acceso__tarjeta">
    <h1 class="mb-2">Iniciar sesión</h1>
    <p class="text-muted small mb-4">
        Accede con tu cuenta de GenteFit. Verás las opciones según tu rol:
        cliente, recepción, encargado/a o administración.
    </p>

    <form asp-action="Login" method="post" novalidate>
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

        <div class="mb-3">
            <label asp-for="Identificador" class="form-label"></label>
            <input asp-for="Identificador" class="form-control" autocomplete="username" autofocus />
            <span asp-validation-for="Identificador" class="field-validation-error"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Contrasena" class="form-label"></label>
            <input asp-for="Contrasena" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Contrasena" class="field-validation-error"></span>
        </div>

        <div class="form-check mb-4">
            <input asp-for="Recordarme" class="form-check-input" />
            <label asp-for="Recordarme" class="form-check-label"></label>
        </div>

        <button type="submit" class="btn btn-primary w-100">Entrar</button>

        @* E-00: mensaje que no revela si el usuario existe *@
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div class="alert alert-danger mt-3 mb-0" role="alert">
                @ViewData.ModelState[string.Empty]!.Errors[0].ErrorMessage
            </div>
        }
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
